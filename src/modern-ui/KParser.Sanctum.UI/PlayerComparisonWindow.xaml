<Window x:Class="KParser.Sanctum.UI.PlayerComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KParser - Player Build Comparison"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="PanelColor">#22262C</Color>
        <Color x:Key="RaisedColor">#2C3139</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <Color x:Key="RuleColor">#3B424C</Color>
        <Color x:Key="SelectedRowColor">#3B3424</Color>
        <Color x:Key="SelectedRowTextColor">#F0D18A</Color>
        <Color x:Key="RowHoverColor">#2C3139</Color>
        <Color x:Key="FooterColor">#1F242A</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
        <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
        <SolidColorBrush x:Key="SelectedRowBrush" Color="{DynamicResource SelectedRowColor}" />
        <SolidColorBrush x:Key="SelectedRowTextBrush" Color="{DynamicResource SelectedRowTextColor}" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="{DynamicResource RowHoverColor}" />
        <SolidColorBrush x:Key="FooterBrush" Color="{DynamicResource FooterColor}" />
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource SelectedRowTextBrush}" />
                                <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayLabel}"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{StaticResource FieldBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" />
                                                <Path Grid.Column="1"
                                                      Width="9"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                      Fill="{StaticResource MutedTextBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <TextBlock Margin="12,0,42,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding SelectedItem.DisplayLabel, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=Select a saved build}"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="340"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CanvasTextBrush}" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="184" />
                <RowDefinition Height="*" />
                <RowDefinition Height="46" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="KParser - Player Build Comparison"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="—" Style="{StaticResource HeaderButton}" Click="Minimize_Click" />
                    <Button Content="×" Style="{StaticResource HeaderButton}" FontSize="19" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Background="{StaticResource PanelBrush}" Margin="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Margin="18,14,8,14" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <TextBlock Text="BUILD A" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Snapshots}"
                                  SelectedItem="{Binding SelectedFirst, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DarkCombo}"
                                  Margin="0,8,0,12" />
                        <TextBlock Text="{Binding SelectedFirst.PlayerName, TargetNullValue=No saved parse selected}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0">
                            <Run Text="{Binding SelectedFirst.Job}" /><Run Text="  ·  " /><Run Text="{Binding SelectedFirst.EncounterName}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedFirst.TopAction}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="⇄" Width="44" Height="36" FontSize="19" ToolTip="Swap builds" Click="Swap_Click" />
                </StackPanel>

                <Border Grid.Column="2" Margin="8,14,18,14" Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15">
                    <StackPanel>
                        <TextBlock Text="BUILD B" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        <ComboBox ItemsSource="{Binding Snapshots}"
                                  SelectedItem="{Binding SelectedSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource DarkCombo}"
                                  Margin="0,8,0,12" />
                        <TextBlock Text="{Binding SelectedSecond.PlayerName, TargetNullValue=No saved parse selected}" Foreground="{StaticResource PrimaryTextBrush}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0">
                            <Run Text="{Binding SelectedSecond.Job}" /><Run Text="  ·  " /><Run Text="{Binding SelectedSecond.EncounterName}" />
                        </TextBlock>
                        <TextBlock Text="{Binding SelectedSecond.TopAction}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,7,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Background="{StaticResource CanvasBrush}">
                <TextBlock Text="{Binding EmptyStateText}"
                           Foreground="{StaticResource CanvasMutedBrush}"
                           FontSize="16"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <DataGrid ItemsSource="{Binding Metrics}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="{StaticResource CanvasBrush}"
                          Margin="22,18,22,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Metric" Binding="{Binding Metric}" Width="1.55*" />
                        <DataGridTextColumn Header="Build A" Binding="{Binding FirstValue}" Width="1*" />
                        <DataGridTextColumn Header="Build B" Binding="{Binding SecondValue}" Width="1*" />
                        <DataGridTextColumn Header="B vs A" Binding="{Binding Change}" Width="1.15*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="3" Background="{StaticResource FooterBrush}">
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <Button Content="Refresh saved parses" Padding="13,6" Margin="0,0,8,0" Click="Refresh_Click" />
                    <Button Content="Delete Build A" Padding="13,6" Margin="0,0,8,0" Click="DeleteFirst_Click" />
                    <Button Content="Delete Build B" Padding="13,6" Click="DeleteSecond_Click" />
                </StackPanel>
                <TextBlock Text="Build B changes are calculated against Build A"
                           Foreground="{StaticResource CanvasMutedBrush}"
                           FontSize="11"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="0,0,18,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
