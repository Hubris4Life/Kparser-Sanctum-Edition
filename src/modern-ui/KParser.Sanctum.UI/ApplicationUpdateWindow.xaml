<Window x:Class="KParser.Sanctum.UI.ApplicationUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KParser Update"
        Width="760"
        Height="650"
        MinWidth="640"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="PanelColor">#22262C</Color>
        <Color x:Key="RaisedColor">#2C3139</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="AccentHoverColor">#E0BE6F</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <Color x:Key="RuleColor">#3B424C</Color>
        <Color x:Key="SelectedRowColor">#3B3424</Color>
        <Color x:Key="SelectedRowTextColor">#F0D18A</Color>
        <Color x:Key="RowHoverColor">#2C3139</Color>
        <Color x:Key="FooterColor">#1F242A</Color>
        <Color x:Key="DetailTextColor">#AAB0B8</Color>
        <Color x:Key="AccentTextColor">#CAA656</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
        <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
        <SolidColorBrush x:Key="SelectedRowBrush" Color="{DynamicResource SelectedRowColor}" />
        <SolidColorBrush x:Key="SelectedRowTextBrush" Color="{DynamicResource SelectedRowTextColor}" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="{DynamicResource RowHoverColor}" />
        <SolidColorBrush x:Key="FooterBrush" Color="{DynamicResource FooterColor}" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="{DynamicResource DetailTextColor}" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="UpdateButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentUpdateButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource UpdateButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#17191D" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource ChromeBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="KParser - Application Update"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontWeight="SemiBold" />
                <Button x:Name="TitleCloseButton"
                        HorizontalAlignment="Right"
                        Content="×"
                        Style="{StaticResource HeaderButtonStyle}"
                        Click="RemindLater_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,18,22,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="A KParser update is available"
                           Foreground="{StaticResource CanvasTextBrush}"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="VersionSummaryText"
                           Grid.Row="1"
                           Margin="0,5,0,14"
                           Foreground="{StaticResource CanvasMutedBrush}" />

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ReleaseNameText"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ReleaseDateText"
                                   Margin="0,3,0,0"
                                   Foreground="{StaticResource CanvasMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                    <TextBlock x:Name="PageIndicatorText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource CanvasMutedBrush}"
                               FontWeight="SemiBold" />
                </Grid>

                <Border Grid.Row="3"
                        Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Padding="14">
                    <TextBox x:Name="ReleaseNotesText"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{StaticResource CanvasTextBrush}"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             CaretBrush="{StaticResource AccentBrush}" />
                </Border>

                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PackageSummaryText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource CanvasMutedBrush}"
                               FontSize="11" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="PreviousPageButton"
                                Content="← Previous"
                                Margin="0,0,7,0"
                                Style="{StaticResource UpdateButtonStyle}"
                                Click="PreviousPage_Click" />
                        <Button x:Name="NextPageButton"
                                Content="Next →"
                                Style="{StaticResource UpdateButtonStyle}"
                                Click="NextPage_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Background="{StaticResource FooterBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,11">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <ProgressBar x:Name="DownloadProgressBar"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="StatusText"
                                   Margin="0,9,0,0"
                                   Foreground="{StaticResource CanvasMutedBrush}"
                                   FontSize="11" />
                    </Grid>
                    <StackPanel Grid.Row="1"
                                Margin="0,10,0,0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="SkipButton"
                                Content="Skip This Version"
                                Margin="0,0,7,0"
                                Style="{StaticResource UpdateButtonStyle}"
                                Click="SkipVersion_Click" />
                        <Button x:Name="RemindButton"
                                Content="Remind Me Later"
                                Margin="0,0,7,0"
                                Style="{StaticResource UpdateButtonStyle}"
                                Click="RemindLater_Click" />
                        <Button x:Name="InstallButton"
                                Content="Install Update"
                                MinWidth="132"
                                Style="{StaticResource AccentUpdateButtonStyle}"
                                Click="InstallUpdate_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
