<Window x:Class="KParser.Sanctum.UI.DotStatCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Player Stats"
        Width="520"
        Height="300"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <Color x:Key="DetailTextColor">#AAB0B8</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="{DynamicResource DetailTextColor}" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Register Player Stats"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0" />
                <Button Content="×"
                        Width="42"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource MutedTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        Click="Cancel_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Select or enter the character currently logged into FFXI."
                           Foreground="{StaticResource DetailTextBrush}"
                           FontSize="13" />
                <TextBlock Grid.Row="1"
                           Text="The parser does not need to be started. For the best estimate, equip the gear used when applying your DoTs before capturing."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CanvasMutedBrush}"
                           FontSize="11"
                           Margin="0,5,0,13" />
                <ComboBox x:Name="CharacterNameBox"
                          Grid.Row="2"
                          Height="36"
                          IsEditable="True"
                          IsTextSearchEnabled="True"
                          MaxDropDownHeight="220"
                          Padding="8,4"
                          VerticalContentAlignment="Center"
                          Background="{StaticResource FieldBrush}"
                          Foreground="{StaticResource PrimaryTextBrush}"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="1"
                          FontSize="13"
                          KeyDown="CharacterNameBox_KeyDown" />
                <TextBlock Grid.Row="3"
                           Text="Only read access to the selected FFXI client is requested. The character name tells KParser which player should receive the captured calculation profile."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource CanvasMutedBrush}"
                           FontSize="11"
                           Margin="0,12,0,0" />
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Cancel" Width="88" Height="32" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="Register Stats"
                            Width="112"
                            Height="32"
                            Background="#8A6A25"
                            Foreground="White"
                            BorderBrush="{StaticResource AccentBrush}"
                            Click="Capture_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
