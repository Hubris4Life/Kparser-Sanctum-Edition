<Window x:Class="KParser.Sanctum.UI.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KParser Diagnostics"
        Width="920"
        Height="650"
        MinWidth="760"
        MinHeight="480"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="PanelColor">#22262C</Color>
        <Color x:Key="RaisedColor">#2C3139</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
        <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="13,4" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="KParser Diagnostics"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0" />
                <Button Content="×" Width="42" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" FontSize="18"
                        Click="Close_Click" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="18,15,18,12">
                <TextBlock Text="Use this report when troubleshooting memory detection, the parser engine, server compatibility, pet ownership, or application errors."
                           TextWrapping="Wrap" Foreground="{StaticResource CanvasTextBrush}" />
                <TextBlock Text="Personal Windows paths are shortened in copied reports. Character names and process IDs remain visible because they can be necessary for diagnosis."
                           Margin="0,5,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource CanvasMutedBrush}" FontSize="11" />
            </StackPanel>
            <DataGrid x:Name="DiagnosticsGrid" Grid.Row="2" Margin="18,0"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{StaticResource FieldBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                      BorderBrush="{StaticResource BorderBrush}" RowBackground="{StaticResource PanelBrush}"
                      AlternatingRowBackground="{StaticResource ChromeBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="7,5" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Area" Binding="{Binding Category}" Width="145" />
                    <DataGridTextColumn Header="Check" Binding="{Binding Name}" Width="190" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Value}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="18,14,18,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready"
                           Grid.Column="0" Margin="0,0,12,0"
                           VerticalAlignment="Center" Foreground="{StaticResource CanvasMutedBrush}"
                           FontSize="11" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RefreshButton" Content="Refresh" Width="86" Margin="0,0,8,0" Click="Refresh_Click" />
                    <Button Content="Open Logs" Width="96" Margin="0,0,8,0" Click="OpenLogs_Click" />
                    <Button Content="Copy Report" Width="108" Margin="0,0,8,0"
                            Background="#8A6A25" Foreground="White"
                            BorderBrush="{StaticResource AccentBrush}" Click="CopyReport_Click" />
                    <Button Content="Close" Width="82" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
