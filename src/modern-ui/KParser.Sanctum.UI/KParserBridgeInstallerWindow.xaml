<Window x:Class="KParser.Sanctum.UI.KParserBridgeInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KParserBridge Addon"
        Width="760"
        Height="440"
        MinWidth="650"
        MinHeight="400"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <Color x:Key="DetailTextColor">#AAB0B8</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="{DynamicResource DetailTextColor}" />
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Background="{StaticResource ChromeBrush}"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="KParserBridge Addon"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0" />
                <Button Content="×"
                        Width="42"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource MutedTextBrush}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="18"
                        Click="Close_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,16,18,12">
                <TextBlock Text="Optional pet attribution for other servers"
                           Foreground="{StaticResource CanvasTextBrush}"
                           FontSize="17"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,5,0,14"
                           Text="KParserBridge passively observes party and pet entity updates and writes local owner mappings for KParser. It does not alter chat, names, or outgoing packets. Nothing is installed or enabled until you select an Ashita v4 location and click Install / Update."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DetailTextBrush}" />

                <TextBlock Text="Ashita v4 installation"
                           Foreground="{StaticResource CanvasMutedBrush}"
                           Margin="0,0,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LocationComboBox"
                              Height="34"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="LocationComboBox_SelectionChanged" />
                    <Button Grid.Column="1" Content="Browse…" Width="88" Height="34"
                            Margin="8,0,0,0" Click="Browse_Click" />
                    <Button Grid.Column="2" Content="Refresh" Width="82" Height="34"
                            Margin="8,0,0,0" Click="Refresh_Click" />
                </Grid>

                <Border Margin="0,14,0,0"
                        Padding="14,11"
                        Background="{StaticResource FieldBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Bundled version" Foreground="{StaticResource CanvasMutedBrush}" />
                        <TextBlock x:Name="BundledVersionText" Grid.Column="1"
                                   Foreground="{StaticResource CanvasTextBrush}" />
                        <TextBlock Grid.Row="1" Text="Installed status" Margin="0,7,0,0"
                                   Foreground="{StaticResource CanvasMutedBrush}" />
                        <TextBlock x:Name="InstalledStatusText" Grid.Row="1" Grid.Column="1" Margin="0,7,0,0"
                                   Foreground="{StaticResource CanvasTextBrush}" />
                        <TextBlock Grid.Row="2" Text="Install folder" Margin="0,7,0,0"
                                   Foreground="{StaticResource CanvasMutedBrush}" />
                        <TextBlock x:Name="InstallFolderText" Grid.Row="2" Grid.Column="1" Margin="0,7,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource CanvasTextBrush}" />
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText"
                           Margin="0,12,0,0"
                           Text="Select an Ashita location to continue."
                           TextWrapping="Wrap"
                           Foreground="{StaticResource DetailTextBrush}" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="18,0,18,16">
                <TextBlock Text="After installation, load it in game with /addon load kparserbridge."
                           VerticalAlignment="Center"
                           Foreground="{StaticResource CanvasMutedBrush}"
                           FontSize="11" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RemoveButton" Content="Remove" Width="84" Height="32"
                            Margin="0,0,8,0" IsEnabled="False" Click="Remove_Click" />
                    <Button x:Name="InstallButton" Content="Install / Update" Width="124" Height="32"
                            Margin="0,0,8,0" IsEnabled="False" Background="#8A6A25"
                            Foreground="White" BorderBrush="{StaticResource AccentBrush}"
                            Click="Install_Click" />
                    <Button Content="Close" Width="82" Height="32" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
