<Window x:Class="KParser.Sanctum.UI.PlayerInformationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player Information"
        Width="920"
        Height="560"
        MinWidth="720"
        MinHeight="420"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <Color x:Key="DetailTextColor">#AAB0B8</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="{DynamicResource DetailTextColor}" />
    </Window.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Player Information"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0" />
                <Button Content="×" Width="42" HorizontalAlignment="Right"
                        Foreground="{StaticResource MutedTextBrush}" Background="Transparent"
                        BorderThickness="0" FontSize="18" Click="Cancel_Click" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="18,15,18,12">
                <TextBlock Text="Detected players are added automatically. A job override changes only how the modern reports label that player; it does not alter parsed combat data."
                           TextWrapping="Wrap" Foreground="{StaticResource DetailTextBrush}" />
                <TextBlock Text="Leave Job Override blank to use automatic detection. Examples: WAR / SAM, COR / NIN."
                           Margin="0,5,0,0" Foreground="{StaticResource CanvasMutedBrush}" FontSize="11" />
            </StackPanel>
            <DataGrid x:Name="PlayersGrid" Grid.Row="2" Margin="18,0,18,0"
                      ItemsSource="{Binding}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      Background="{StaticResource FieldBrush}" Foreground="{StaticResource PrimaryTextBrush}"
                      BorderBrush="{StaticResource BorderBrush}" RowBackground="{StaticResource CanvasBrush}"
                      AlternatingRowBackground="{StaticResource ChromeBrush}"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="7,5" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Player" Binding="{Binding Name}" IsReadOnly="True" Width="1.2*" />
                    <DataGridTextColumn Header="Detected Job" Binding="{Binding DetectedJob}" IsReadOnly="True" Width="1*" />
                    <DataGridTextColumn Header="Job Override" Binding="{Binding JobOverride, UpdateSourceTrigger=PropertyChanged}" Width="1.1*" />
                    <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="2.5*" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyStateText" Grid.Row="2"
                       Margin="48,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="No logged-in players detected. Start the parser after entering the game, then reopen Player Information."
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="520"
                       Foreground="{StaticResource CanvasMutedBrush}" FontSize="13"
                       IsHitTestVisible="False" Visibility="Collapsed" />
            <Grid Grid.Row="3" Margin="18,14,18,16">
                <TextBlock Text="Player information is stored locally for this Windows account."
                           VerticalAlignment="Center" Foreground="{StaticResource CanvasMutedBrush}" FontSize="11" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Width="88" Height="32" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button Content="Save" Width="96" Height="32" Background="#8A6A25"
                            Foreground="White" BorderBrush="{StaticResource AccentBrush}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
