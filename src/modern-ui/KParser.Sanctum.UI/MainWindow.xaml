<Window x:Class="KParser.Sanctum.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:KParser.Sanctum.UI.Controls"
        Title="Kparser - Sanctum Edition"
        Width="1450"
        Height="900"
        MinWidth="1380"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource InterfaceFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Color x:Key="ChromeColor">#1B1E23</Color>
        <Color x:Key="PanelColor">#22262C</Color>
        <Color x:Key="RaisedColor">#2C3139</Color>
        <Color x:Key="FieldColor">#16191D</Color>
        <Color x:Key="BorderColor">#424953</Color>
        <Color x:Key="AccentColor">#CAA656</Color>
        <Color x:Key="AccentHoverColor">#E0BE6F</Color>
        <Color x:Key="PrimaryTextColor">#EBEDF0</Color>
        <Color x:Key="MutedTextColor">#AAB0B8</Color>
        <Color x:Key="CanvasColor">#22262C</Color>
        <Color x:Key="CanvasTextColor">#EBEDF0</Color>
        <Color x:Key="CanvasMutedColor">#AAB0B8</Color>
        <Color x:Key="RuleColor">#3B424C</Color>
        <Color x:Key="SelectedRowColor">#3B3424</Color>
        <Color x:Key="SelectedRowTextColor">#F0D18A</Color>
        <Color x:Key="RowHoverColor">#2C3139</Color>
        <Color x:Key="FooterColor">#1F242A</Color>
        <Color x:Key="DetailTextColor">#AAB0B8</Color>
        <Color x:Key="AccentTextColor">#CAA656</Color>
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" />
        <SolidColorBrush x:Key="RaisedBrush" Color="{DynamicResource RaisedColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{DynamicResource FieldColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
        <SolidColorBrush x:Key="ChromeTextBrush" Color="{DynamicResource PrimaryTextColor}" />
        <SolidColorBrush x:Key="MutedChromeTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="CanvasBrush" Color="{DynamicResource CanvasColor}" />
        <SolidColorBrush x:Key="CanvasTextBrush" Color="{DynamicResource CanvasTextColor}" />
        <SolidColorBrush x:Key="CanvasMutedBrush" Color="{DynamicResource CanvasMutedColor}" />
        <SolidColorBrush x:Key="RuleBrush" Color="{DynamicResource RuleColor}" />
        <SolidColorBrush x:Key="SelectedRowBrush" Color="{DynamicResource SelectedRowColor}" />
        <SolidColorBrush x:Key="SelectedRowTextBrush" Color="{DynamicResource SelectedRowTextColor}" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="{DynamicResource RowHoverColor}" />
        <SolidColorBrush x:Key="FooterBrush" Color="{DynamicResource FooterColor}" />
        <SolidColorBrush x:Key="DetailTextBrush" Color="{DynamicResource DetailTextColor}" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />

        <Style TargetType="{x:Type MenuItem}">
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="34,8,14,8" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="CheckMark"
                                          Grid.Column="0"
                                          Width="11"
                                          Height="8"
                                          Margin="10,0,0,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          Data="M 1 4 L 4 7 L 10 1"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                    <ContentPresenter x:Name="HeaderPresenter"
                                                      Grid.Column="0"
                                                      Margin="{TemplateBinding Padding}"
                                                      ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="GestureText"
                                               Grid.Column="1"
                                               Margin="24,0,8,0"
                                               Text="{TemplateBinding InputGestureText}"
                                               Foreground="{StaticResource MutedChromeTextBrush}"
                                               VerticalAlignment="Center" />
                                    <Path x:Name="SubmenuArrow"
                                          Grid.Column="2"
                                          Width="5"
                                          Height="8"
                                          Margin="8,0,10,0"
                                          Data="M 0 0 L 5 4 L 0 8 Z"
                                          Fill="{StaticResource MutedChromeTextBrush}"
                                          Stretch="Fill"
                                          Visibility="Collapsed"
                                          VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Right"
                                   PopupAnimation="Fade">
                                <Border MinWidth="230"
                                        Padding="4"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="2">
                                    <ScrollViewer CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" />
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="MinHeight" Value="34" />
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter Property="Padding" Value="10,6" />
                                <Setter Property="MinHeight" Value="34" />
                                <Setter TargetName="GestureText" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="SubmenuArrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedChromeTextBrush}" />
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Separator}">
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Border Height="1" Background="{StaticResource BorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MainTitleButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource MutedChromeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TitleButtonBorder" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource RowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource ChromeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentChromeButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ChromeButtonStyle}">
            <Setter Property="Background" Value="#8A6A25" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="NavigationTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedChromeTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="{TemplateBinding Background}">
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                            <Border x:Name="AccentLine"
                                    Height="3"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
                                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter TargetName="AccentLine" Property="Background" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterComboStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource ChromeTextBrush}" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{StaticResource FieldBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" />
                                                <Path Grid.Column="1"
                                                      Width="9"
                                                      Height="5"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 5 L 9 0 Z"
                                                      Fill="{StaticResource MutedChromeTextBrush}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="13,0,40,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="280"
                                        Background="{StaticResource FieldBrush}"
                                        BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SummaryValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CanvasTextBrush}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="SummaryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource CanvasMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource MutedChromeTextBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
            <Setter Property="Foreground" Value="{StaticResource CanvasTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Job}" Value="Say">
                    <Setter Property="Foreground" Value="#626870" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Shout">
                    <Setter Property="Foreground" Value="#B76613" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Shout / Yell">
                    <Setter Property="Foreground" Value="#B76613" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Tell">
                    <Setter Property="Foreground" Value="#A33482" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Party">
                    <Setter Property="Foreground" Value="#2665A8" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Linkshell">
                    <Setter Property="Foreground" Value="#247A48" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Emote">
                    <Setter Property="Foreground" Value="#61469B" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Job}" Value="Arena">
                    <Setter Property="Foreground" Value="#8B5625" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource SelectedRowTextBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelectedRowBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="42" />
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ChromeBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Menu Grid.Column="0"
                  Background="{StaticResource ChromeBrush}"
                  Foreground="{StaticResource ChromeTextBrush}"
                  FontSize="14"
                  VerticalContentAlignment="Center">
                <MenuItem Header="File" Padding="10,6">
                    <MenuItem Header="Save selected player parse..."
                              IsEnabled="{Binding CanSavePlayerSnapshot}"
                              Click="SavePlayerSnapshot_Click" />
                    <Separator />
                    <MenuItem Header="Export current report as CSV…" Click="ExportReport_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="Exit_Click" />
                </MenuItem>
                <MenuItem Header="Edit" Padding="10,6">
                    <MenuItem Header="Copy current report" Click="CopyReport_Click" />
                    <MenuItem Header="Copy selected combatant" Click="CopySelectedCombatant_Click" />
                </MenuItem>
                <MenuItem Header="Tools" Padding="10,6">
                    <MenuItem Header="Live Monitor" Click="OpenCurrentFight_Click" />
                    <MenuItem Header="Player Build Comparison" Click="OpenPlayerComparison_Click" />
                    <MenuItem Header="Diagnostics…" Click="Diagnostics_Click" />
                    <Separator />
                    <MenuItem x:Name="KParserBridgeAddonMenuItem"
                              Header="KParserBridge Addon…"
                              Click="ManageKParserBridge_Click" />
                </MenuItem>
                <MenuItem Header="Server" Padding="10,6">
                    <MenuItem x:Name="SanctumXiServerMenuItem"
                              Header="Sanctum XI"
                              IsCheckable="True"
                              Click="SanctumXiServer_Click" />
                    <MenuItem x:Name="OtherServerMenuItem"
                              Header="Other"
                              IsCheckable="True"
                              Click="OtherServer_Click" />
                </MenuItem>
                <MenuItem Header="Options" Padding="10,6">
                    <MenuItem Header="Player Information…" Click="PlayerInformation_Click" />
                    <Separator />
                    <MenuItem Header="Detect memory now" Command="{Binding DetectMemoryCommand}" IsEnabled="{Binding IsDetectEnabled}" />
                    <MenuItem Header="Register Player Stats…"
                              IsEnabled="{Binding CanCaptureDotStats}"
                              Click="CaptureDotStats_Click" />
                    <Separator />
                    <MenuItem x:Name="DisplayPetDamageSeparatelyMenuItem"
                              Header="Display Pet Damage Separately"
                              IsCheckable="True"
                              Click="DisplayPetDamageSeparately_Click" />
                    <Separator />
                    <MenuItem x:Name="AutoDetectMemoryMenuItem"
                              Header="Auto-detect memory on startup"
                              IsCheckable="True"
                              Click="AutoDetectMemory_Click" />
                    <MenuItem x:Name="AutomaticUpdateChecksMenuItem"
                              Header="Check for updates on startup"
                              IsCheckable="True"
                              Click="AutomaticUpdateChecks_Click" />
                    <MenuItem x:Name="PrereleaseUpdatesMenuItem"
                              Header="Include preview updates"
                              IsCheckable="True"
                              Click="PrereleaseUpdates_Click" />
                    <Separator />
                    <MenuItem x:Name="LightModeMenuItem"
                              Header="Light Mode"
                              IsCheckable="True"
                              Click="LightMode_Click" />
                </MenuItem>
                <MenuItem Header="Help" Padding="10,6">
                    <MenuItem Header="Check for Updates…" Click="CheckForUpdates_Click" />
                </MenuItem>
            </Menu>
            <Border Grid.Column="1" Background="Transparent" MouseLeftButtonDown="MainWindowDragArea_MouseLeftButtonDown">
                <TextBlock Text="Kparser - Sanctum Edition"
                           Foreground="{StaticResource MutedChromeTextBrush}"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="—" Click="MainMinimize_Click" Style="{StaticResource MainTitleButtonStyle}" />
                <Button Content="□" Click="MainMaximize_Click" Style="{StaticResource MainTitleButtonStyle}" />
                <Button Content="×" Click="MainClose_Click" Style="{StaticResource MainTitleButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Background="{StaticResource ChromeBrush}">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Damage Dealt" GroupName="ReportTabs" IsChecked="{Binding IsDamageDealtSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Damage Taken" GroupName="ReportTabs" IsChecked="{Binding IsDamageTakenSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Healing" GroupName="ReportTabs" IsChecked="{Binding IsHealingSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Buffs" GroupName="ReportTabs" IsChecked="{Binding IsBuffsSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Debuffs" GroupName="ReportTabs" IsChecked="{Binding IsDebuffsSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Deaths" GroupName="ReportTabs" IsChecked="{Binding IsDeathsSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Fights" GroupName="ReportTabs" IsChecked="{Binding IsFightsSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="EXP" GroupName="ReportTabs" IsChecked="{Binding IsExperienceSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Chat" GroupName="ReportTabs" IsChecked="{Binding IsChatSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Items &amp; Loot" GroupName="ReportTabs" IsChecked="{Binding IsLootSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
                <RadioButton Content="Crafting" GroupName="ReportTabs" IsChecked="{Binding IsCraftingSelected, Mode=TwoWay}" Style="{StaticResource NavigationTabStyle}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ActiveServerLabel}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Margin="0,0,18,0"
                           VerticalAlignment="Center" />
                <Ellipse Width="9" Height="9" Fill="{Binding ParserStatusBrush}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding ConnectionBadge}" Foreground="{StaticResource MutedChromeTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Background="{StaticResource PanelBrush}" Margin="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="14,7,6,7">
                <TextBlock Text="{Binding EncounterFilterLabel}" Foreground="{StaticResource MutedChromeTextBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Encounters}"
                          SelectedItem="{Binding SelectedEncounter, Mode=TwoWay}"
                          Style="{StaticResource FilterComboStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="6,7">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowCombatantFilter}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding CombatantFilterLabel}" Foreground="{StaticResource MutedChromeTextBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding CombatantScopes}"
                          SelectedItem="{Binding SelectedCombatantScope}"
                          Style="{StaticResource FilterComboStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="6,7">
                <TextBlock Text="Display" Foreground="{StaticResource MutedChromeTextBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding DisplayModes}"
                          SelectedItem="{Binding SelectedDisplayMode}"
                          Style="{StaticResource FilterComboStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="6,7">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSearchFilter}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Group by" Foreground="{StaticResource MutedChromeTextBrush}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding GroupingModes}"
                          SelectedItem="{Binding SelectedGroupMode}"
                          Style="{StaticResource FilterComboStyle}" />
            </StackPanel>

            <StackPanel Grid.Column="3" Margin="6,7">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSearchFilter}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding SearchFilterLabel}" Foreground="{StaticResource MutedChromeTextBrush}" Margin="0,0,0,4" />
                <TextBox Text="{Binding ReportSearchText, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                         Height="28"
                         MinWidth="360"
                         Padding="8,4"
                         Background="{StaticResource FieldBrush}"
                         Foreground="{StaticResource ChromeTextBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         CaretBrush="{StaticResource ChromeTextBrush}"
                         ToolTip="Filter by message, speaker, item, recipient, mob, recipe, material, or craft skill" />
            </StackPanel>

            <StackPanel Grid.Column="4" Margin="6,23,14,7" Orientation="Horizontal">
                <Button Content="Start" Command="{Binding StartParserCommand}" IsEnabled="{Binding IsStartEnabled}" Style="{StaticResource AccentChromeButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Stop" Command="{Binding StopParserCommand}" IsEnabled="{Binding IsStopEnabled}" Style="{StaticResource ChromeButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Reset" Command="{Binding ResetParserCommand}" IsEnabled="{Binding IsResetEnabled}" Style="{StaticResource ChromeButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Live Monitor" Click="OpenCurrentFight_Click" Style="{StaticResource ChromeButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Save Parse" Click="SavePlayerSnapshot_Click" IsEnabled="{Binding CanSavePlayerSnapshot}" Style="{StaticResource ChromeButtonStyle}" Margin="0,0,6,0" />
                <Button Content="Export" Click="ExportReport_Click" Style="{StaticResource ChromeButtonStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Background="{StaticResource CanvasBrush}" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="112" />
                <RowDefinition Height="3" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="TotalRowDefinition" Height="40" />
                <RowDefinition x:Name="FooterRowDefinition" Height="56" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,24,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding EncounterTitle}"
                               Foreground="{StaticResource CanvasTextBrush}"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding EncounterSubtitle}"
                               Foreground="{StaticResource CanvasMutedBrush}"
                               FontSize="13"
                               Margin="0,9,0,0" />
                    <TextBlock Text="{Binding RefreshText}"
                               Foreground="{StaticResource AccentTextBrush}"
                               FontSize="11"
                               Margin="0,8,0,0" />
                    <DockPanel Margin="0,5,0,0" LastChildFill="True">
                        <Button Content="Register Player Stats"
                                DockPanel.Dock="Left"
                                Height="25"
                                Padding="10,2"
                                Margin="0,0,10,0"
                                IsEnabled="{Binding CanCaptureDotStats}"
                                Click="CaptureDotStats_Click"
                                ToolTip="Read the logged-in character's current stats without starting a parse" />
                        <TextBlock Text="{Binding EngineActionText}"
                                   Foreground="{StaticResource DetailTextBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="28,0,0,0">
                        <TextBlock Text="DURATION" Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock Text="{Binding Duration}" Style="{StaticResource SummaryValueStyle}" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Margin="34,0,0,0">
                        <TextBlock Text="{Binding SummaryTotalLabel}" Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock Text="{Binding TotalDamage}" Style="{StaticResource SummaryValueStyle}" Margin="0,7,0,0" />
                    </StackPanel>
                    <StackPanel Margin="34,0,0,0">
                        <TextBlock Text="{Binding SummaryRateLabel}" Style="{StaticResource SummaryLabelStyle}" />
                        <TextBlock Text="{Binding AllianceDps}" Style="{StaticResource SummaryValueStyle}" Margin="0,7,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource AccentBrush}" Margin="28,0" />

            <DataGrid Grid.Row="2"
                      Margin="28,14,28,0"
                      ItemsSource="{Binding Combatants}"
                      SelectedItem="{Binding SelectedCombatant}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      Background="{StaticResource CanvasBrush}"
                      Foreground="{StaticResource CanvasTextBrush}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      ScrollViewer.CanContentScroll="True">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimelineSelected}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="RankColumn" Header="#" Binding="{Binding Rank}" Width="48" />
                    <DataGridTextColumn x:Name="NameColumn" Header="Combatant" Binding="{Binding Name}" Width="1.5*" />
                    <DataGridTextColumn x:Name="SecondaryColumn" Header="Job" Binding="{Binding Job}" Width="1.15*" />
                    <DataGridTextColumn x:Name="PrimaryColumn" Header="Damage" Binding="{Binding DamageDisplay}" Width="1.05*" />
                    <DataGridTextColumn x:Name="ShareColumn" Header="Share" Binding="{Binding ShareDisplay}" Width="0.8*" />
                    <DataGridTextColumn x:Name="RateColumn" Header="DPS" Binding="{Binding DpsDisplay}" Width="0.85*" />
                    <DataGridTextColumn x:Name="Detail1Column" Header="Melee" Binding="{Binding MeleeDisplay}" Width="1.05*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="Detail2Column" Header="Weapon skills" Binding="{Binding WeaponSkillsDisplay}" Width="1.25*" />
                    <DataGridTextColumn x:Name="Detail3Column" Header="Magic" Binding="{Binding MagicDisplay}" Width="0.95*" />
                    <DataGridTextColumn x:Name="Detail4Column" Header="Other" Binding="{Binding OtherDisplay}" Width="0.9*" />
                    <DataGridTextColumn x:Name="AccuracyColumn" Header="Accuracy" Binding="{Binding AccuracyDisplay}" Width="0.8*" />
                    <DataGridTextColumn x:Name="CriticalRateColumn" Header="Crit. rate" Binding="{Binding CriticalRateDisplay}" Width="0.8*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    Margin="28,14,28,8"
                    Background="{StaticResource CanvasBrush}"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="1"
                    CornerRadius="3">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTimelineSelected}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:DamageTimelineControl ItemsSource="{Binding Combatants}" Margin="8" />
            </Border>

            <Border Grid.Row="3"
                    Margin="28,0"
                    Background="{StaticResource CanvasBrush}"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTotalRow}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.85*" />
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="1.25*" />
                        <ColumnDefinition Width="0.95*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="{Binding TotalRowLabel}" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Grid.Column="3" Text="{Binding TotalDamage}" FontWeight="SemiBold" Foreground="{StaticResource CanvasTextBrush}" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Grid.Column="4" Text="100.0%" FontWeight="SemiBold" Foreground="{StaticResource CanvasTextBrush}" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Grid.Column="5" Text="{Binding AllianceDps}" FontWeight="SemiBold" Foreground="{StaticResource CanvasTextBrush}" VerticalAlignment="Center" Margin="12,0" />
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Margin="28,8,28,10"
                    Background="{StaticResource FooterBrush}"
                    BorderBrush="{StaticResource RuleBrush}"
                    BorderThickness="0,1,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowSelectedFooter}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="16,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding SelectedCombatant.Name, TargetNullValue=Select a combatant}"
                               Foreground="{StaticResource AccentTextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,28,0" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedCombatant.TopAction}"
                               Foreground="{StaticResource DetailTextBrush}" VerticalAlignment="Center" Margin="0,0,28,0" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedCombatant.Accuracy}"
                               Foreground="{StaticResource DetailTextBrush}" VerticalAlignment="Center" Margin="0,0,28,0" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedCombatant.CriticalRate}"
                               Foreground="{StaticResource DetailTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding FooterRightText}"
                               Foreground="{StaticResource DetailTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    <Grid Grid.Row="1" Grid.ColumnSpan="5">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowDamageSourceFooter}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedCombatant.SourceBreakdownDisplay}"
                                   Foreground="{StaticResource CanvasMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,20,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedCombatant.PhysicalBreakdownDisplay}"
                                   Foreground="{StaticResource CanvasMutedBrush}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Background="{StaticResource ChromeBrush}">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <Ellipse Width="9" Height="9" Fill="{Binding ParserStatusBrush}" Margin="0,0,9,0" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedChromeTextBrush}" />
            </StackPanel>
            <TextBlock Text="{Binding EventStatus}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="{StaticResource MutedChromeTextBrush}" />
        </Grid>
    </Grid>
</Window>
